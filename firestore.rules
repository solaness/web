rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.onboardingCompleted == false;

      // Clients may only flip onboardingCompleted from false to true (a
      // one-time onboarding completion); flipping it back to false, or
      // touching it once it's already true, is not allowed. uid and email
      // also can't be rewritten to values other than the caller's own.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && (
          request.resource.data.onboardingCompleted == resource.data.onboardingCompleted
          || (resource.data.onboardingCompleted == false && request.resource.data.onboardingCompleted == true)
        );

      // 즐겨찾기(북마크)는 각 사용자 문서 아래 서브컬렉션으로 두고, 본인 것만
      // 읽고 쓸 수 있게 한다. 문서 id는 placeId라 목록 조회 없이도 단건 조회/삭제가 된다.
      // saveBookmark()가 보내는 필드셋/타입을 그대로 강제해서, 앱을 거치지 않고
      // Firestore를 직접 호출해도 형식이 어긋난 데이터를 못 쓰게 막는다.
      // savedAt은 serverTimestamp()만 허용해(request.time과 동일해야 함) 클라이언트가
      // 임의의 시각으로 목록 정렬 순서를 조작할 수 없게 한다.
      match /bookmarks/{placeId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;

        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
            'placeId', 'name', 'address', 'thumbnailUrl',
            'categories', 'isIndoorExperience', 'savedAt',
          ])
          && request.resource.data.placeId == placeId
          && request.resource.data.name is string
          && request.resource.data.address is string
          && request.resource.data.thumbnailUrl is string
          && request.resource.data.categories is list
          && request.resource.data.isIndoorExperience is bool
          && request.resource.data.savedAt == request.time;
      }

      // 방문 기록도 북마크와 같은 원리로 사용자 문서 아래 서브컬렉션에 둔다. 다만 같은
      // 장소를 여러 날 방문할 수 있어 문서 id를 placeId로 고정할 수 없으므로 Firestore가
      // 자동 생성한 id를 그대로 쓴다(= docId를 특정 필드와 비교하는 제약이 없다).
      // 본인의 방문 기록만 조회, 생성 및 삭제할 수 있다.
      // 수정 기능은 아직 없으므로 update 권한은 허용하지 않는다.
      match /visitRecords/{recordId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
            'date', 'placeId', 'placeName', 'address', 'category',
            'sunshineScore', 'sunshineMinutes', 'scorePerMinute',
            'visitStartTime', 'visitEndTime', 'activityNote', 'imageUrl',
            'visitStatus', 'createdAt',
          ])
          && request.resource.data.date is string
          && request.resource.data.placeId is string
          && request.resource.data.placeName is string
          && request.resource.data.address is string
          && request.resource.data.category is string
          && request.resource.data.sunshineScore is number
          && request.resource.data.sunshineMinutes is number
          && request.resource.data.scorePerMinute is number
          && request.resource.data.createdAt == request.time
          && (!('visitStartTime' in request.resource.data) || request.resource.data.visitStartTime is string)
          && (!('visitEndTime' in request.resource.data) || request.resource.data.visitEndTime is string)
          && (!('activityNote' in request.resource.data) || request.resource.data.activityNote is string)
          && (!('imageUrl' in request.resource.data) || request.resource.data.imageUrl is string)
          && (!('visitStatus' in request.resource.data) || request.resource.data.visitStatus is string);
      }
    }

    // Deny by default for any collection not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
