rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.onboardingCompleted == false;

      // Clients may not flip onboardingCompleted themselves (that must be
      // done by trusted server-side logic, e.g. a Cloud Function); uid and
      // email also can't be rewritten to values other than the caller's own.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.onboardingCompleted == resource.data.onboardingCompleted;
    }

    // Deny by default for any collection not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
